# Mini Enterprise Defensive SOC Dashboard Configuration Template
# DO NOT commit actual secrets or live .env files to version control.
# Copy this file to .env and replace placeholder values with random secrets.

# --- Backend Listener Settings ---
# Bind host: 127.0.0.1 for local-only testing; 0.0.0.0 to allow access from separate lab VMs
SOC_BIND_HOST=127.0.0.1
# Port for Flask backend HTTP listener (default: 8443)
SOC_PORT=8443
# Path to SQLite telemetry database (default: ./soc_telemetry.db)
SOC_DB_PATH=./soc_telemetry.db

# --- Authentication Credentials (MUST be separate strong random secrets) ---
# Secret for agent/detector telemetry ingestion via POST /api/events
SOC_AGENT_TOKEN=replace_with_random_agent_secret
# Alias for SOC_AGENT_TOKEN (set to same value if Secure Portal uses SOC_API_KEY)
SOC_API_KEY=replace_with_random_agent_secret
# Secret for dashboard analyst session authentication (UI toolbar & /api/soc/*)
ANALYST_TOKEN=replace_with_different_random_analyst_secret

# --- Remediation Poller Settings (agent_remediator.py on Linux CN-Server) ---
# Destination base URL for remediation poller (e.g. http://192.168.x.x:8443 or https://...)
SOC_BASE_URL=http://127.0.0.1:8443
# Remediation poller interval in seconds (minimum 2s)
SOC_POLL_SECONDS=3
# Verify TLS certificate (set to false if using plain HTTP in lab test environment)
SOC_VERIFY_TLS=false
# SOAR dry-run mode (keep true until tested; prevents direct firewall changes)
SOAR_DRY_RUN=true
